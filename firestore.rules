rules_version = '2';

// ============================================================
// ObraGo - Reglas de seguridad de Firestore
// Estas reglas se ejecutan en los SERVIDORES de Google, no en la app.
// Aunque alguien modifique la app, no puede saltarse estas reglas.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funciones auxiliares ----------
    function isSignedIn() { return request.auth != null; }
    function userData()   { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin()    { return isSignedIn() && userData().role == 'admin'; }
    function isStore()    { return isSignedIn() && userData().role == 'store'; }
    function isClient()   { return isSignedIn() && userData().role == 'client'; }

    // Flujo valido de estados de un pedido (solo la ferreteria lo avanza)
    function validTransition(from, to, method) {
      return (from == 'pending'   && (to == 'accepted' || to == 'rejected'))
          || (from == 'accepted'  && to == 'preparing')
          || (from == 'preparing' && ((to == 'ready_for_pickup' && method == 'pickup')
                                   || (to == 'dispatched'       && method == 'delivery')))
          || ((from == 'ready_for_pickup' || from == 'dispatched') && to == 'completed');
    }

    // ---------- users ----------
    match /users/{uid} {
      allow read:   if isSignedIn() && (request.auth.uid == uid || isAdmin());
      // Al registrarse solo puede elegir 'client' o 'store'. 'admin' se asigna a mano.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role in ['client', 'store'];
      // Puede editar su perfil, pero NO cambiar su rol
      allow update: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // ---------- stores (ferreterias). El id del documento = uid del dueno ----------
    match /stores/{storeId} {
      allow read: if isSignedIn();
      allow create: if isStore() && request.auth.uid == storeId
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.ratingAvg == 0
                    && request.resource.data.ratingCount == 0;
      allow update: if
          // 1) el dueno edita su negocio (pero no status ni calificacion)
          (isStore() && request.auth.uid == storeId
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['ownerId', 'status', 'ratingAvg', 'ratingCount', 'createdAt']))
          // 2) el admin aprueba / suspende
          || isAdmin()
          // 3) un cliente SOLO puede actualizar la calificacion (al enviar una resena)
          || (isClient()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg', 'ratingCount'])
            && request.resource.data.ratingCount == resource.data.ratingCount + 1);
      allow delete: if isAdmin();
    }

    // ---------- catalog (catalogo maestro de materiales) ----------
    match /catalog/{catalogId} {
      allow read:   if isSignedIn();
      allow create: if isStore() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ---------- storeProducts (producto + precio de cada ferreteria) ----------
    // id del documento = {storeId}_{catalogId}
    match /storeProducts/{productId} {
      allow read: if isSignedIn();
      allow create: if isStore()
                    && request.resource.data.storeId == request.auth.uid
                    && productId == request.auth.uid + '_' + request.resource.data.catalogId
                    && request.resource.data.price is number
                    && request.resource.data.price > 0;
      allow update: if isStore()
                    && resource.data.storeId == request.auth.uid
                    && request.resource.data.storeId == resource.data.storeId
                    && request.resource.data.catalogId == resource.data.catalogId
                    && request.resource.data.price is number
                    && request.resource.data.price > 0;
      allow delete: if isStore() && resource.data.storeId == request.auth.uid;
    }

    // ---------- orders (pedidos) ----------
    match /orders/{orderId} {
      // Solo el cliente dueno del pedido, la ferreteria elegida o el admin
      allow read: if isSignedIn()
                  && (resource.data.clientId == request.auth.uid
                      || resource.data.storeId == request.auth.uid
                      || isAdmin());
      // El cliente crea el pedido siempre en 'pending'
      allow create: if isClient()
                    && request.resource.data.clientId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.deliveryMethod in ['delivery', 'pickup']
                    && request.resource.data.items.size() > 0
                    && request.resource.data.items.size() <= 50
                    && exists(/databases/$(database)/documents/stores/$(request.resource.data.storeId));
      // Solo la ferreteria del pedido cambia el estado, siguiendo el flujo valido
      allow update: if isStore()
                    && resource.data.storeId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'statusHistory', 'updatedAt', 'rejectionReason'])
                    && validTransition(resource.data.status,
                                       request.resource.data.status,
                                       resource.data.deliveryMethod);
      allow delete: if false;
    }

    // ---------- reviews (resenas). id = id del pedido => 1 resena por pedido ----------
    match /reviews/{orderId} {
      allow read: if isSignedIn();
      allow create: if isClient()
                    && request.resource.data.clientId == request.auth.uid
                    && get(/databases/$(database)/documents/orders/$(orderId)).data.clientId == request.auth.uid
                    && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'completed'
                    && request.resource.data.storeId == get(/databases/$(database)/documents/orders/$(orderId)).data.storeId
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }
  }
}
